/* Modern Cyberpunk / Dracula Dark Theme for YTMusic TUI */

Screen {
    background: #121212;
    color: #f8f8f2;
    layout: vertical;
    overflow: hidden;
}

/* Header Bar */
HeaderBar {
    height: 3;
    dock: top;
    background: #1e1e24;
    border-bottom: heavy #27272a;
    padding: 0 1;
}

#header_container {
    width: 100%;
    height: 100%;
    align: left middle;
}

#header_logo {
    width: auto;
    padding-right: 2;
}

#header_view_indicator {
    width: 1fr;
    text-align: left;
}

#header_badges {
    width: auto;
    align: right middle;
}

.badge {
    margin-left: 1;
    padding: 0 1;
    background: #121212;
    border: round #27272a;
}

/* Main Body Layout: Sidebar + Content Area */
#main_body_container {
    height: 1fr;
    width: 100%;
    layout: horizontal;
    background: #121212;
}

/* Sidebar Navigation (~25%) */
SidebarNav {
    width: 25%;
    min-width: 26;
    max-width: 38;
    height: 100%;
    background: #18181e;
    border-right: heavy #27272a;
}

#sidebar_container {
    height: 100%;
    width: 100%;
    padding: 1 1 0 1;
}

.nav_section_title {
    height: 1;
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
    color: #bd93f9;
}

#nav_list {
    height: auto;
    margin-bottom: 1;
    background: transparent;
    border: none;
}

#nav_list > ListItem {
    padding: 0 1;
    height: 2;
    background: transparent;
    color: #f8f8f2;
}

#nav_list > ListItem:hover {
    background: #282a36;
    color: #00e5ff;
}

#nav_list > ListItem.-selected {
    background: #282a36;
    color: #00e5ff;
    text-style: bold;
    border-left: wide #00e5ff;
}

#sidebar_help {
    height: 1fr;
    border-top: solid #27272a;
    padding-top: 1;
}

.help_row {
    height: 1;
    color: #6272a4;
    padding-left: 1;
}

/* Content Area (~75%) */
#content_switcher {
    width: 1fr;
    height: 100%;
    background: #121212;
    padding: 0 1;
}

.view_content_container {
    height: 100%;
    width: 100%;
    layout: vertical;
}

.view_banner {
    height: 2;
    padding: 0 1;
    background: #1e1e24;
    border-bottom: solid #27272a;
    margin-bottom: 1;
    content-align: left middle;
}

/* Sticky Bottom Player Bar */
BottomPlayerBar {
    height: 6;
    dock: bottom;
    background: #18181e;
    border-top: heavy #27272a;
    padding: 0 1;
}

#player_bar_container {
    height: 100%;
    width: 100%;
    layout: vertical;
}

#player_track_row {
    height: 1;
    width: 100%;
    align: left middle;
}

#player_title_info {
    width: 1fr;
    text-overflow: ellipsis;
}

#player_meta_badges {
    width: auto;
    align: right middle;
}

#player_quality_badge {
    margin-right: 1;
    padding: 0 1;
    background: #121212;
    border: round #27272a;
}

#player_autoplay_badge {
    padding: 0 1;
    background: #121212;
    border: round #27272a;
}

#player_seek_container {
    height: 1;
    width: 100%;
    margin: 1 0 0 0;
    align: center middle;
}

#player_seek_bar {
    width: 100%;
    content-align: center middle;
}

#player_controls_row {
    height: 1;
    width: 100%;
    align: left middle;
    margin-top: 1;
}

#player_state_badge {
    width: auto;
    padding-right: 2;
}

#player_volume_badge {
    width: auto;
    padding-right: 2;
}

#player_queue_badge {
    width: auto;
    padding-right: 2;
}

#player_hotkeys_hint {
    width: 1fr;
    text-align: right;
    color: #6272a4;
}

/* Data Tables */
DataTable {
    background: #141418;
    border: solid #27272a;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #1e1e24;
    color: #00e5ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #282a36;
    color: #50fa7b;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1f2029;
}

/* Cards & Containers */
#radio_seed_card, #playlist_header_card, #queue_header_card {
    height: auto;
    background: #1e1e24;
    border: solid #27272a;
    padding: 1 2;
    margin-bottom: 1;
}

#radio_action_buttons, #pl_detail_buttons, #queue_action_buttons {
    height: 3;
    margin-top: 1;
    align: left middle;
}

#radio_action_buttons > Button, #pl_detail_buttons > Button, #queue_action_buttons > Button {
    margin-right: 2;
}

/* Moods & Playlists Split Pane */
#moods_split_container {
    height: 1fr;
    width: 100%;
    layout: horizontal;
}

#moods_left_pane {
    width: 32%;
    height: 100%;
    background: #18181e;
    border: solid #27272a;
    padding: 0 1;
    margin-right: 1;
}

#moods_right_pane {
    width: 68%;
    height: 100%;
    layout: vertical;
}

.pane_title {
    height: 2;
    padding: 0 1;
    border-bottom: solid #27272a;
    content-align: left middle;
    text-style: bold;
}

#categories_list {
    height: 1fr;
    background: transparent;
    border: none;
}

#categories_list > ListItem {
    padding: 0 1;
    height: 2;
    color: #f8f8f2;
}

#categories_list > ListItem:hover {
    background: #282a36;
    color: #00e5ff;
}

#categories_list > ListItem.-selected {
    background: #282a36;
    color: #00e5ff;
    text-style: bold;
    border-left: wide #bd93f9;
}

/* Search Box */
#search_bar_container {
    height: 4;
    margin-bottom: 1;
    background: #1e1e24;
    border: solid #27272a;
    padding: 0 1;
    align: left middle;
}

#search_input {
    width: 100%;
    background: #121212;
    border: solid #27272a;
    color: #f8f8f2;
}

#search_input:focus {
    border: solid #00e5ff;
}

/* Buttons */
Button {
    background: #282a36;
    color: #f8f8f2;
    border: solid #6272a4;
    height: 3;
    padding: 0 2;
}

Button:hover {
    background: #44475a;
    border: solid #00e5ff;
}

Button.-primary {
    background: #00e5ff;
    color: #121212;
    border: solid #00e5ff;
    text-style: bold;
}

Button.-primary:hover {
    background: #80f2ff;
}

Button.-error {
    background: #ff5555;
    color: #121212;
    border: solid #ff5555;
    text-style: bold;
}

Button.-error:hover {
    background: #ff6e6e;
}

/* Tabs */
TabbedContent {
    height: 1fr;
    background: transparent;
}

Tabs {
    background: #1e1e24;
    border-bottom: solid #27272a;
}

Tab {
    color: #6272a4;
    padding: 0 2;
}

Tab.-active {
    color: #00e5ff;
    text-style: bold;
    border-bottom: wide #00e5ff;
}
