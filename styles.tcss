/* ytmusic-tui — minimal terminal stylesheet.
 * All colors are CSS variables injected by the Omarchy theme engine,
 * so switching themes never rewrites or reparses this file.
 *
 * Backgrounds resolve to `ansi_default` so the terminal's own background
 * (and its opacity/transparency) shows through. */

App {
    background: ansi_default;
}

Screen {
    background: $ytm-bg;
    color: $ytm-fg;
    layout: vertical;
    overflow: hidden;
    layers: base overlay;
}

/* ------------------------------------------------------------------ */
/* Top bar: view tabs on the left, playback state on the right         */
/* ------------------------------------------------------------------ */
TopBar {
    dock: top;
    height: 2;
    background: $ytm-panel;
    padding: 0 0 1 0;
    content-align: left middle;
}

/* ------------------------------------------------------------------ */
/* Main content                                                        */
/* ------------------------------------------------------------------ */
#content_switcher {
    width: 100%;
    height: 1fr;
    background: $ytm-bg;
}

.view_content_container {
    width: 100%;
    height: 100%;
    layout: vertical;
}

.section_header {
    height: 1;
    padding: 0 2;
    background: ansi_default;
}

/* ------------------------------------------------------------------ */
/* Data tables                                                         */
/* ------------------------------------------------------------------ */
DataTable {
    height: 1fr;
    background: ansi_default;
    border: none;
    padding: 0 2;
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: transparent;
    color: $ytm-muted;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $ytm-hover;
    color: $ytm-fg;
}

DataTable > .datatable--cursor {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $ytm-surface;
}

DataTable > .datatable--fixed {
    background: $ytm-panel;
}

/* ------------------------------------------------------------------ */
/* Tabs                                                                */
/* ------------------------------------------------------------------ */
TabbedContent {
    height: 1fr;
    background: transparent;
}

Tabs {
    height: 1;
    background: transparent;
    border: none;
}

Tab {
    height: 1;
    padding: 0 1;
    color: $ytm-muted;
    background: transparent;
    text-style: none;
}

Tab:hover {
    color: $ytm-fg;
}

Tab.-active {
    color: $ytm-accent;
    background: transparent;
    text-style: bold;
}

/* ------------------------------------------------------------------ */
/* Moods split pane                                                    */
/* ------------------------------------------------------------------ */
#moods_split {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#categories_pane {
    width: 30;
    min-width: 22;
    height: 100%;
    background: transparent;
    padding-right: 2;
}

#categories_list {
    height: 1fr;
    background: ansi_default;
    border: none;
    padding: 0;
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
}

#categories_list > ListItem {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $ytm-fg;
}

#categories_list > ListItem:hover {
    background: $ytm-hover;
    color: $ytm-accent;
}

#categories_list > ListItem.-highlight {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

#categories_list > ListItem.-selected {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

#playlists_pane {
    width: 1fr;
    height: 100%;
}

/* ------------------------------------------------------------------ */
/* Search input                                                        */
/* ------------------------------------------------------------------ */
#search_input {
    height: 1;
    margin: 1 2 0 2;
    background: $ytm-panel;
    color: $ytm-fg;
    border: none;
    padding: 0 1;
}

#search_input:focus {
    background: $ytm-hover;
    color: $ytm-accent;
}

/* ------------------------------------------------------------------ */
/* Bottom player bar                                                   */
/* ------------------------------------------------------------------ */
PlayerBar {
    dock: bottom;
    height: auto;
    background: $ytm-panel;
    padding: 1 2 0 2;
    layout: vertical;
}

#player_row {
    height: 1;
    width: 100%;
}

#player_now {
    width: 1fr;
    text-overflow: ellipsis;
    color: $ytm-fg;
}

#player_meta {
    width: auto;
    color: $ytm-muted;
}

SeekBar {
    height: 1;
    width: 100%;
}

#spectrum {
    height: 5;
    width: 100%;
    padding: 0 2;
    margin: 0 0 1 0;
}

#player_help {
    height: 1;
    width: 100%;
}

/* ------------------------------------------------------------------ */
/* Help overlay                                                        */
/* ------------------------------------------------------------------ */
HelpScreen {
    align: center middle;
    background: ansi_default;
}

#help_panel {
    width: 70;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: $ytm-surface;
    border: none;
    padding: 1 3;
}

.help_title {
    height: 1;
    color: $ytm-accent;
    text-style: bold;
}

.help_line {
    height: auto;
    color: $ytm-fg;
}

.help_footer {
    height: 1;
    color: $ytm-muted;
}

/* ------------------------------------------------------------------ */
/* Account overlay                                                     */
/* ------------------------------------------------------------------ */
AccountScreen {
    align: center middle;
    background: ansi_default;
}

#account_panel {
    width: 74;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: $ytm-surface;
    border: none;
    padding: 1 3;
}

#account_body {
    height: auto;
    color: $ytm-fg;
    margin: 1 0;
}

#account_note {
    height: auto;
    color: $ytm-muted;
}

#account_client_id, #account_client_secret {
    height: 3;
    margin: 0 0 1 0;
    background: ansi_default;
    color: $ytm-fg;
    border: none;
    padding: 0 1;
}

#account_client_id:focus, #account_client_secret:focus {
    background: $ytm-hover;
    color: $ytm-accent;
}

#account_buttons {
    height: 3;
    margin-top: 1;
}

#account_buttons > Button {
    margin-right: 2;
}

#account_status {
    height: auto;
    margin-top: 1;
    color: $ytm-muted;
}

/* Borderless buttons (used by the account overlay) */
Button {
    border: none;
    background: $ytm-hover;
    color: $ytm-fg;
    height: 3;
    min-width: 12;
    padding: 0 2;
}

Button:hover {
    background: $ytm-active;
    color: $ytm-accent;
}
