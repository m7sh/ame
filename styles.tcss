/* ame — minimal terminal stylesheet.
 * All colors are CSS variables injected by the Omarchy theme engine,
 * so switching themes never rewrites or reparses this file.
 *
 * Backgrounds resolve to `ansi_default` so the terminal's own background
 * (and its opacity/transparency) shows through. */

App {
    background: ansi_default;
}

Screen {
    background: ansi_default;
    color: $ame-fg;
    layout: vertical;
    overflow: hidden;
    layers: base overlay;
}

/* ------------------------------------------------------------------ */
/* Top bar: view tabs on the left, playback state on the right         */
/* ------------------------------------------------------------------ */
TopBar {
    dock: top;
    height: 2;
    background: ansi_default;
    padding: 0 0 1 0;
    content-align: left middle;
}

/* ------------------------------------------------------------------ */
/* Matrix digital-rain visualizer (top of the screen)                  */
/* ------------------------------------------------------------------ */
#spectrum {
    height: 7;
    width: 100%;
    background: ansi_default;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* ------------------------------------------------------------------ */
/* Main content                                                        */
/* ------------------------------------------------------------------ */
#content_switcher {
    width: 100%;
    height: 1fr;
    background: ansi_default;
}

.view_content_container {
    width: 100%;
    height: 100%;
    layout: vertical;
}

.section_header {
    height: 1;
    padding: 0 2;
    background: ansi_default;
}

/* ------------------------------------------------------------------ */
/* Data tables                                                         */
/* ------------------------------------------------------------------ */
DataTable {
    height: 1fr;
    background: ansi_default;
    border: none;
    padding: 0 2;
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: transparent;
    color: $ame-muted;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $ame-hover;
    color: $ame-fg;
}

DataTable > .datatable--cursor {
    background: $ame-hover;
    color: $ame-primary;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $ame-surface;
}

DataTable > .datatable--fixed {
    background: $ame-panel;
}

/* ------------------------------------------------------------------ */
/* Tabs                                                                */
/* ------------------------------------------------------------------ */
TabbedContent {
    height: 1fr;
    background: transparent;
}

Tabs {
    height: 1;
    background: transparent;
    border: none;
}

Tab {
    height: 1;
    padding: 0 1;
    color: $ame-muted;
    background: transparent;
    text-style: none;
}

Tab:hover {
    color: $ame-fg;
}

Tab.-active {
    color: $ame-accent;
    background: transparent;
    text-style: bold;
}

/* ------------------------------------------------------------------ */
/* Moods split pane                                                    */
/* ------------------------------------------------------------------ */
#moods_split {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#categories_pane {
    width: 30;
    min-width: 22;
    height: 100%;
    background: transparent;
    padding-right: 2;
}

#categories_list {
    height: 1fr;
    background: ansi_default;
    border: none;
    padding: 0;
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
}

#categories_list > ListItem {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $ame-fg;
}

#categories_list > ListItem:hover {
    background: $ame-hover;
    color: $ame-accent;
}

#categories_list > ListItem.-highlight {
    background: $ame-hover;
    color: $ame-primary;
    text-style: bold;
}

#categories_list > ListItem.-selected {
    background: $ame-hover;
    color: $ame-primary;
    text-style: bold;
}

#playlists_pane {
    width: 1fr;
    height: 100%;
}

/* ------------------------------------------------------------------ */
/* Search input                                                        */
/* ------------------------------------------------------------------ */
#search_input {
    height: 1;
    margin: 1 2 0 2;
    background: ansi_default;
    color: $ame-fg;
    border: none;
    padding: 0 1;
}

#search_input:focus {
    background: $ame-hover;
    color: $ame-accent;
}

/* ------------------------------------------------------------------ */
/* Bottom player bar                                                   */
/* ------------------------------------------------------------------ */
PlayerBar {
    dock: bottom;
    height: auto;
    background: ansi_default;
    padding: 1 2 0 2;
    layout: vertical;
}

#player_row {
    height: 1;
    width: 100%;
}

#player_now {
    width: 1fr;
    text-overflow: ellipsis;
    color: $ame-fg;
}

#player_meta {
    width: auto;
    color: $ame-muted;
}

SeekBar {
    height: 1;
    width: 100%;
}

/* ------------------------------------------------------------------ */
/* Help overlay                                                        */
/* ------------------------------------------------------------------ */
HelpScreen {
    align: center middle;
    background: ansi_default;
}

#help_panel {
    width: 70;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: ansi_default;
    border: none;
    padding: 1 3;
}

.help_title {
    height: 1;
    color: $ame-accent;
    text-style: bold;
}

.help_line {
    height: auto;
    color: $ame-fg;
}

.help_footer {
    height: 1;
    color: $ame-muted;
}
