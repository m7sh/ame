/* ytmusic-tui — minimal terminal stylesheet.
 * All colors are CSS variables injected by the Omarchy theme engine,
 * so switching themes never rewrites or reparses this file. */

Screen {
    background: $ytm-bg;
    color: $ytm-fg;
    layout: vertical;
    overflow: hidden;
    layers: base overlay;
}

/* ------------------------------------------------------------------ */
/* Top bar: view tabs on the left, playback state on the right         */
/* ------------------------------------------------------------------ */
TopBar {
    dock: top;
    height: 2;
    background: $ytm-panel;
    border-bottom: solid $ytm-border;
    padding: 0;
    content-align: left middle;
}

/* ------------------------------------------------------------------ */
/* Main content                                                        */
/* ------------------------------------------------------------------ */
#content_switcher {
    width: 100%;
    height: 1fr;
    background: $ytm-bg;
}

.view_content_container {
    width: 100%;
    height: 100%;
    layout: vertical;
}

.section_header {
    height: 1;
    padding: 0 2;
    background: transparent;
}

/* ------------------------------------------------------------------ */
/* Data tables                                                         */
/* ------------------------------------------------------------------ */
DataTable {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: $ytm-border;
    scrollbar-background: transparent;
}

DataTable > .datatable--header {
    background: transparent;
    color: $ytm-muted;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $ytm-hover;
    color: $ytm-fg;
}

DataTable > .datatable--cursor {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $ytm-surface;
}

DataTable > .datatable--fixed {
    background: $ytm-panel;
}

/* ------------------------------------------------------------------ */
/* Tabs                                                                */
/* ------------------------------------------------------------------ */
TabbedContent {
    height: 1fr;
    background: transparent;
}

Tabs {
    height: 1;
    background: transparent;
    border: none;
}

Tab {
    height: 1;
    padding: 0 1;
    color: $ytm-muted;
    background: transparent;
    text-style: none;
}

Tab:hover {
    color: $ytm-fg;
}

Tab.-active {
    color: $ytm-accent;
    background: transparent;
    text-style: bold;
}

/* ------------------------------------------------------------------ */
/* Moods split pane                                                    */
/* ------------------------------------------------------------------ */
#moods_split {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#categories_pane {
    width: 30;
    min-width: 22;
    height: 100%;
    background: transparent;
    border-right: solid $ytm-border;
}

#categories_list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#categories_list > ListItem {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $ytm-fg;
}

#categories_list > ListItem:hover {
    background: $ytm-hover;
    color: $ytm-accent;
}

#categories_list > ListItem.-highlight {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

#categories_list > ListItem.-selected {
    background: $ytm-hover;
    color: $ytm-primary;
    text-style: bold;
}

#playlists_pane {
    width: 1fr;
    height: 100%;
}

/* ------------------------------------------------------------------ */
/* Search input                                                        */
/* ------------------------------------------------------------------ */
#search_input {
    height: 3;
    margin: 1 2 0 2;
    background: $ytm-panel;
    color: $ytm-fg;
    border: round $ytm-border;
    padding: 0 1;
}

#search_input:focus {
    border: round $ytm-accent;
}

/* ------------------------------------------------------------------ */
/* Bottom player bar                                                   */
/* ------------------------------------------------------------------ */
PlayerBar {
    dock: bottom;
    height: auto;
    background: $ytm-panel;
    border-top: solid $ytm-border;
    padding: 0 2;
    layout: vertical;
}

#player_row {
    height: 1;
    width: 100%;
}

#player_now {
    width: 1fr;
    text-overflow: ellipsis;
    color: $ytm-fg;
}

#player_meta {
    width: auto;
    color: $ytm-muted;
}

SeekBar {
    height: 1;
    width: 100%;
}

#player_spectrum {
    height: 5;
    width: 100%;
    margin: 0 0 1 0;
}

#player_help {
    height: 1;
    width: 100%;
}

/* ------------------------------------------------------------------ */
/* Help overlay                                                        */
/* ------------------------------------------------------------------ */
HelpScreen {
    align: center middle;
    background: $ytm-bg 85%;
}

#help_panel {
    width: 70;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: $ytm-panel;
    border: round $ytm-border;
    padding: 1 2;
}

.help_title {
    height: 1;
    color: $ytm-accent;
    text-style: bold;
}

.help_line {
    height: auto;
    color: $ytm-fg;
}

.help_footer {
    height: 1;
    color: $ytm-muted;
}
